{
  "additionalProperties": false,
  "properties": {
    "unitId": {
      "description": "Unit whose processed material is used.",
      "examples": [
        "unidad-1"
      ],
      "title": "Unitid",
      "type": "string"
    },
    "outcomeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Learning outcome of the unit, optional.",
      "title": "Outcomeid"
    },
    "stage": {
      "description": "5E stage of the requested resource.",
      "enum": [
        "engage",
        "explore",
        "explain",
        "elaborate",
        "evaluate"
      ],
      "examples": [
        "evaluate"
      ],
      "title": "Stage",
      "type": "string"
    },
    "resourceType": {
      "enum": [
        "pregunta_detonante",
        "sondeo_diagnostico",
        "guia_exploracion",
        "caso_indagacion",
        "explicacion",
        "glosario",
        "ejercicio_aplicacion",
        "item_opcion_multiple"
      ],
      "examples": [
        "item_opcion_multiple"
      ],
      "title": "Resourcetype",
      "type": "string"
    },
    "quantity": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "Quantity",
      "type": "integer"
    },
    "difficulty": {
      "default": "intermedia",
      "enum": [
        "basica",
        "intermedia",
        "avanzada"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "optionCount": {
      "default": 4,
      "description": "Options per multiple-choice item.",
      "maximum": 5,
      "minimum": 2,
      "title": "Optioncount",
      "type": "integer"
    },
    "topK": {
      "default": 10,
      "description": "Chunks retrieved from the material (BM25).",
      "maximum": 50,
      "minimum": 1,
      "title": "Topk",
      "type": "integer"
    },
    "evidenceThreshold": {
      "default": 0.6,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Evidencethreshold",
      "type": "number"
    },
    "instructions": {
      "default": "",
      "description": "Free text from the teacher.",
      "maxLength": 500,
      "title": "Instructions",
      "type": "string"
    },
    "audience": {
      "default": "",
      "examples": [
        "Tercer ciclo"
      ],
      "maxLength": 200,
      "title": "Audience",
      "type": "string"
    },
    "competency": {
      "default": "",
      "maxLength": 200,
      "title": "Competency",
      "type": "string"
    },
    "modalities": {
      "description": "Sprint 1 generates text only.",
      "items": {
        "const": "Textual",
        "type": "string"
      },
      "maxItems": 1,
      "title": "Modalities",
      "type": "array"
    }
  },
  "required": [
    "unitId",
    "stage",
    "resourceType"
  ],
  "title": "GenerationRequest",
  "type": "object"
}