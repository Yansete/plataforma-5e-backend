# Copiar este archivo como .env (cp .env.example .env). El archivo .env no se sube al repositorio.
# Valores solo para desarrollo local: no reutilizar esta contraseña en ningún servidor.

# Usuario, contraseña y nombre de la base de datos que crea el contenedor de PostgreSQL al iniciarse por primera vez.
POSTGRES_USER=plataforma5e
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=plataforma5e

# Puerto del equipo en el que se expone PostgreSQL. Cambiarlo si ya hay otro PostgreSQL usando el 5432.
POSTGRES_PORT=5432

# Cadena de conexión del entorno dbmate o de un cliente SQL. Debe coincidir con los valores anteriores.
# Las migraciones (dbmate) no la usan: construyen su propia conexión dentro de Docker.
# El backend SQLAlchemy usa DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/base
# Establecer esa URL en la terminal del backend; conservar el esquema postgres:// de dbmate aquí.
DATABASE_URL=postgres://plataforma5e:cambiar-en-local@localhost:5432/plataforma5e?sslmode=disable

# --- Backend (FastAPI) ---
# El backend no lee este archivo: estas variables se exportan en la terminal (local) o se definen en Render.
# DATABASE_URL (arriba) también sirve para SQLAlchemy: el backend convierte postgres:// a postgresql+psycopg://.
CORS_ORIGENES=http://localhost:5173
IA_PROVEEDOR=reglas          # gemini | anthropic | openai | reglas
IA_API_KEY=                  # nunca se sube al repositorio
IA_MODELO=                   # opcional
BUSQUEDA_POR_TEMA=true
